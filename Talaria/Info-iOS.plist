<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundleDisplayName</key>
    <string>Talaria</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>$(MARKETING_VERSION)</string>
    <key>CFBundleVersion</key>
    <string>$(CURRENT_PROJECT_VERSION)</string>
    <!-- Lets the Share Extension hand off a staged share via
         `talaria://share?id=<uuid>` (opaque lookup key into the App Group
         container — see docs/security.md). No other inbound use today. -->
    <key>CFBundleURLTypes</key>
    <array>
        <dict>
            <key>CFBundleURLName</key>
            <string>io.lyx.Talaria.share</string>
            <key>CFBundleURLSchemes</key>
            <array>
                <string>talaria</string>
            </array>
        </dict>
    </array>
    <!-- Export-compliance self-classification. Set false to declare that the
         app uses only exempt encryption (standard SSH/TLS for transport, no
         proprietary crypto), which suppresses the per-upload TestFlight
         compliance prompt and avoids the annual self-classification filing.
         CONFIRM this is accurate for your distribution before submitting —
         it is a legal declaration to Apple/BIS, not a build setting. -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>
    <key>LSRequiresIPhoneOS</key>
    <true/>
    <!-- Required for SSH connections to servers on the local network
         (self-hosted Hermes on a LAN IP or .local host). Without this key
         iOS silently blocks the outbound TCP connect, which surfaces as an
         opaque NIO channel error. -->
    <key>NSLocalNetworkUsageDescription</key>
    <string>Talaria connects to your Hermes server over SSH, which may be on your local network.</string>
    <!-- Required to capture a photo from the composer's Camera attachment
         row. Without this key the app crashes on camera launch. -->
    <key>NSCameraUsageDescription</key>
    <string>Talaria uses the camera to attach a photo to your chat message.</string>
    <key>UILaunchScreen</key>
    <dict/>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.talaria.kanban-card</string>
            <key>UTTypeDescription</key>
            <string>Talaria Kanban Card</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
            <key>UTTypeTagSpecification</key>
            <dict/>
        </dict>
    </array>
</dict>
</plist>
